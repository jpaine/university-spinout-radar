// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies    Company[]
  people       Person[]
  templates    Template[]
  outreachLogs OutreachLog[]
  feedItems    FeedItem[]
  technologies Technology[]

  @@index([slug])
}

model Company {
  id                String   @id @default(cuid())
  universityId      String
  slug              String
  name              String
  description       String?
  website           String?
  linkedinUrl       String?
  tags              String[] // e.g., ["AI", "Robotics", "AI-enabled robotics"]
  segment           String? // e.g., "Enterprise", "Consumer", etc.
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  newThisWeek       Boolean  @default(false)
  // Investor-relevant fields
  foundedDate       DateTime?
  fundingStage      String? // e.g., "Pre-Seed", "Seed", "Series A"
  fundingRaised     String? // e.g., "£2M", "£500K" — free-text for flexibility
  technologySummary String? // Brief summary of IP/technology
  investmentStatus  String? // e.g., "Raising", "Funded", "Bootstrapped"
  sector            String? // e.g., "HealthTech", "DeepTech", "AI", "CleanTech"
  isEcosystemOrg    Boolean  @default(false) // true = support org, false = investable company

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  people     Person[]
  feedItems  FeedItem[]

  @@unique([universityId, slug])
  @@index([universityId])
  @@index([universityId, slug])
  @@index([newThisWeek])
  @@index([isEcosystemOrg])
  @@index([sector])
}

model Person {
  id              String    @id @default(cuid())
  universityId    String
  companyId       String?
  slug            String
  firstName       String
  lastName        String
  email           String?
  linkedinUrl     String?
  profileUrl      String?
  otherUrls       String[] // Array of evidence URLs
  tags            String[] // e.g., ["AI", "Robotics"]
  segment         String? // e.g., "Enterprise", "Consumer"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  newThisWeek     Boolean   @default(false)
  lastContactedAt DateTime?
  nextTouchAt     DateTime?

  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  outreachLogs OutreachLog[]
  feedItems    FeedItem[]

  @@unique([universityId, slug])
  @@index([universityId])
  @@index([universityId, slug])
  @@index([companyId])
  @@index([nextTouchAt])
  @@index([newThisWeek])
}

model Template {
  id           String   @id @default(cuid())
  universityId String
  name         String
  subject      String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  outreachLogs OutreachLog[]

  @@index([universityId])
}

model OutreachLog {
  id           String   @id @default(cuid())
  universityId String
  personId     String
  templateId   String?
  sentAt       DateTime @default(now())
  notes        String?

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([universityId])
  @@index([personId])
  @@index([sentAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique // Clerk user_id
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  status               String // active, canceled, past_due, etc.
  plan                 String? // pro_monthly, pro_annual
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model FeedItem {
  id           String   @id @default(cuid())
  universityId String
  companyId    String?
  personId     String?
  type         String // "new_spinout", "funding_round", "event", "news", "new_person"
  title        String
  summary      String?
  sourceUrl    String?
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person     Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([universityId, publishedAt])
  @@index([type])
  @@index([companyId])
}

// Pre-company IP available for licensing from Oxford — future spinout pipeline
model Technology {
  id              String   @id @default(cuid())
  universityId    String
  ouiRef          String?  // OUI reference number e.g. "2024/3421"
  title           String
  summary         String?
  sector          String?  // e.g. "Life Sciences", "Deep Tech", "AI"
  tags            String[]
  sourceUrl       String?  // link to OUI technology page
  status          String   @default("available") // "available", "licensed", "spinout_formed"
  publishedAt     DateTime? // when OUI listed it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([sector])
  @@index([status])
  @@index([publishedAt])
}

model Watchlist {
  id           String   @id @default(cuid())
  userId       String   // Clerk user_id
  companyId    String?  // specific company watch
  sector       String?  // watch all companies in a sector
  fundingStage String?  // watch all at a specific stage
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  email           String? // user's email address for sending
  weeklyDigest    Boolean @default(true)
  newSpinoutAlert Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}
